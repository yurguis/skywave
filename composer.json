{
    "name": "yurguis/skywave",
    "description": "Live TV, guide and recordings from an antenna, for HDHomeRun tuners",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Yurguis Garcia",
            "email": "yurguis@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-zlib": "*",
        "symfony/http-foundation": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "Skywave\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skywave\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.3"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    }
}
