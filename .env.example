# Copy to .env and adjust. docker compose reads .env automatically.

# Docker Desktop (macOS, Windows): publish the port instead of using host networking.
#COMPOSE_FILE=docker-compose.yml:docker-compose.macos.yml

# Sign-in for the web UI (HTTP basic auth). Required unless AUTH_DISABLED=1.
AUTH_USER=admin
AUTH_PASSWORD=

# Port the UI listens on.
HTTP_PORT=8090

# HTTPS. Point TLS_DIR at a folder holding a certificate and its key, and the UI serves
# TLS on TLS_PORT as well as plain HTTP on HTTP_PORT. Without them only HTTP is served.
# A certificate from a public authority (Let's Encrypt via DNS-01) is trusted by browsers
# and accepted by Cloudflare's Full (strict); see "HTTPS" in README.md.
TLS_DIR=./certs
TLS_PORT=8443
TLS_CERT=/certs/fullchain.pem
TLS_KEY=/certs/privkey.pem

# Tuners broadcast discovery cannot find, comma separated.
HDHOMERUN_DEVICES=

# Live playback: concurrent transcodes, and the picture heights each one offers. Players
# switch between them as the connection allows (mobile data). An HD stream with 720,480,360
# uses about 3 CPU threads; 720 alone about 1.7; 1080,720,480,360 about 3.8.
MAX_STREAMS=2
HLS_RENDITIONS=720,480,360

# How far back viewers can rewind a live stream, in minutes. Segments of every rendition
# are kept in memory in Docker (tmpfs): with 720,480,360 each minute costs about 25 MB per
# stream, up to 46 MB for busy scenes at the bitrate caps (SD channels use far less).
HLS_DVR_MINUTES=5

# Program guide: minutes between automatic updates by the guide service.
GUIDE_INTERVAL=240

# Recordings: where to keep them (a folder on this machine, mounted into the containers),
# and how they are written. "ts" keeps the broadcast untouched and costs no CPU, about
# 1-4 GB an hour; "mp4" converts while recording (about 2-3 CPU threads) and plays in a
# browser without a transcoder; "both" records the broadcast and converts a copy once it
# ends, which costs no tuner time and keeps the original. Each recording can override this
# when it is scheduled. Docker Desktop must be allowed to share the folder.
RECORDINGS_DIR=./data/recordings
RECORDING_HEIGHT=720

# Watching a "ts" recording back converts it on the fly (about 20x faster than playback);
# these are the picture heights it converts to, tallest first, up to 4. One size costs the
# least. Several let a player drop to a smaller picture when the connection tightens rather
# than stalling, which is worth the extra encoding when watching from outside the house;
# they share one deinterlace, so three sizes cost nearer 1.4x than 3x.
#
# RECORDING_PLAYBACK_HEIGHT named the single size this used to make, and still works as one.
RECORDING_PLAYBACK_RENDITIONS=720

# Every recording keeps the broadcast as it was sent, plus a copy a browser can play, made
# once the program ends. This is what that copy is. "hls" writes a finished playlist at the
# sizes above: the length and the seek bar are there the moment it opens, nothing is
# transcoded while you watch, and it plays the same from outside the house. It is stereo,
# because a browser will not reliably decode 5.1, and it is a directory rather than a file.
# "mp4" writes one file instead, with the broadcast's surround sound intact.
RECORDING_CONVERT_TO=hls

# Seconds to record before a program starts and after it ends, for broadcasts that run late.
RECORDING_PAD_START=60
RECORDING_PAD_END=180

# Simulator profile only: a raw MPEG-TS recording and the channel that carries it.
CAPTURE_FILE=
CAPTURE_CHANNEL=33

# HD Radio (needs the radio overlay and a locally built nrsc5; see "HD Radio" in README.md).
# Say where the dongle is and the radio appears in the page; leave both empty and it is off.
# RADIO_RTL_TCP is a dongle shared by rtl_tcp, as host or host:port. RADIO_DEVICE is one
# plugged into this machine, counting from 0.
#COMPOSE_FILE=docker-compose.yml:docker-compose.radio.yml
RADIO_RTL_TCP=
RADIO_DEVICE=
# Tuner gain in dB and the dongle's frequency error in ppm; empty lets nrsc5 choose.
RADIO_GAIN=
RADIO_PPM=
# Seconds a scan waits on each frequency before calling it empty (6 when unset). The dial
# is 101 frequencies, so this is most of how long a scan takes.
RADIO_SCAN_SECONDS=

# Radio simulator profile only: a capture of raw I/Q samples (unsigned 8-bit, 1488375
# samples a second, as "nrsc5 -w" writes it) and the frequency that carries it.
RADIO_CAPTURE_FILE=
RADIO_CAPTURE_FREQUENCY=90.5
