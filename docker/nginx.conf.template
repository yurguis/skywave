# Rendered by docker/entrypoint.sh: @HTTP_PORT@, @RUNTIME_DIR@ and @AUTH_DIRECTIVES@
# are replaced at container start. Everything writable lives in @RUNTIME_DIR@ so nginx
# can run as a non-root user.

worker_processes auto;
pid @RUNTIME_DIR@/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Cloudflare names the real client in CF-Connecting-IP. Every request reaches nginx from
    # the Docker gateway, so $remote_addr only ever says "the gateway" and cannot tell a
    # phone on the far side of the internet from the machine this runs on; the header is the
    # only thing that does. X-Forwarded-For is kept beside it for anything else in front.
    #
    # Logged, not trusted. Nothing here can tell a forged header from a real one -- every
    # request arrives from the same address, so there is no proxy to believe and no client
    # to disbelieve. Treating it as the client's address would let anything on the network
    # choose what the log says about it. Reading it is safe; acting on it would not be.
    log_format skywave '$remote_addr - $remote_user [$time_local] "$request" '
                       '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                       'cf="$http_cf_connecting_ip" xff="$http_x_forwarded_for"';

    access_log /dev/stdout skywave;
    # A second copy where the page can read it. Filled in by the entrypoint only when the
    # data volume is writable: a log nginx cannot open would stop it from starting at all.
    @ACCESS_LOG@
    sendfile on;
    server_tokens off;
    client_max_body_size 64k;

    client_body_temp_path @RUNTIME_DIR@/client_body;
    proxy_temp_path @RUNTIME_DIR@/proxy;
    fastcgi_temp_path @RUNTIME_DIR@/fastcgi;
    uwsgi_temp_path @RUNTIME_DIR@/uwsgi;
    scgi_temp_path @RUNTIME_DIR@/scgi;

    gzip on;
    gzip_types text/css application/javascript application/json;

    server {
        listen @HTTP_PORT@;
        # TLS is served from the same place when a certificate is given; the entrypoint
        # leaves this empty when there is none, so the port keeps working without one.
        @TLS_LISTEN@
        root /app/public;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        # app.js and app.css keep their names across releases; make browsers revalidate
        # (a cheap 304 when unchanged) instead of running a stale copy after an upgrade.
        add_header Cache-Control no-cache always;

        @AUTH_DIRECTIVES@

        # Health check: goes through php-fpm, needs no password, local requests only.
        location = /fpm-ping {
            auth_basic off;
            allow 127.0.0.1;
            deny all;
            access_log off;
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_pass unix:@RUNTIME_DIR@/php-fpm.sock;
        }

        location / {
            try_files $uri /index.php$is_args$args;
        }

        location = /index.php {
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_pass unix:@RUNTIME_DIR@/php-fpm.sock;
            # A live stream analysis can take up to a minute.
            fastcgi_read_timeout 120s;
        }

        # index.php is the only PHP entry point.
        location ~ \.php$ {
            return 404;
        }

        location ~ /\. {
            deny all;
        }
    }
}
